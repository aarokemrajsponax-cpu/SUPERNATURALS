local DefenseMath = Harness.load("Shared/Combat/DefenseMath")
local FighterState = Harness.load("Shared/Combat/FighterState")
local HitResolver = Harness.load("Shared/Combat/HitResolver")
local Combat = Harness.load("Shared/Config/Combat")

return function(t)
	t.test("timing bar: centre is perfect, near is good, far fails", function()
		local defense = Combat.Defense
		t.equal(DefenseMath.gradeTiming(10.03, 10, defense.PerfectWindow, defense.GoodWindow), "Perfect", "perfect")
		t.equal(DefenseMath.gradeTiming(9.88, 10, defense.PerfectWindow, defense.GoodWindow), "Good", "early good")
		t.equal(DefenseMath.gradeTiming(10.12, 10, defense.PerfectWindow, defense.GoodWindow), "Good", "late good")
		t.equal(DefenseMath.gradeTiming(10.4, 10, defense.PerfectWindow, defense.GoodWindow), "Failed", "too late")
		t.equal(DefenseMath.gradeTiming(9.5, 10, defense.PerfectWindow, defense.GoodWindow), "Failed", "too early")
	end)

	t.test("latency allowance uses half the ping and is capped", function()
		t.near(DefenseMath.estimatePressTime(10, 0.1, 0.15), 9.95, 1e-9, "half ping")
		t.near(DefenseMath.estimatePressTime(10, 2, 0.15), 9.85, 1e-9, "capped")
		t.near(DefenseMath.estimatePressTime(10, nil, 0.15), 10, 1e-9, "no ping")
		t.near(DefenseMath.estimatePressTime(10, 0 / 0, 0.15), 10, 1e-9, "junk ping")
	end)

	t.test("grab escape: presses count only when spaced out and before the deadline", function()
		local mash = DefenseMath.newMash(3, 2, 0.07)
		t.equal(DefenseMath.press(mash, 0.1), true, "first")
		t.equal(DefenseMath.press(mash, 0.12), false, "too fast (macro spam)")
		t.equal(DefenseMath.press(mash, 0.2), true, "second")
		t.equal(DefenseMath.escaped(mash), false, "not yet")
		t.equal(DefenseMath.press(mash, 2.5), false, "after the deadline")
		t.equal(DefenseMath.press(mash, 0.3), true, "third")
		t.equal(DefenseMath.escaped(mash), true, "escaped")
	end)

	t.test("prompt window: reads inside the window (with allowance) count", function()
		t.equal(DefenseMath.inPromptWindow(9.6, 9.4, 10, 0.1), true, "inside")
		t.equal(DefenseMath.inPromptWindow(9.35, 9.4, 10, 0.1), true, "just early, within allowance")
		t.equal(DefenseMath.inPromptWindow(9, 9.4, 10, 0.1), false, "way early")
		t.equal(DefenseMath.inPromptWindow(nil, 9.4, 10, 0.1), false, "no defense")
	end)

	t.test("abilities use attack timing and can be cut short or extended", function()
		local state = FighterState.new("A", Combat, 0)
		local attack = FighterState.startAbility(state, { Startup = 0.4, Active = 0.2, Recovery = 0.3, MoveSpeed = 0 }, 1)
		t.truthy(attack, "started")
		t.equal(FighterState.isAttacking(state, 1.5), true, "busy during it")
		local speed = FighterState.movement(state, Combat, 1.1)
		t.equal(speed, 0, "rooted while casting")
		local blocked, reason = FighterState.startAbility(state, { Startup = 0.1, Active = 0.1, Recovery = 0.1 }, 1.2)
		t.equal(blocked, nil, "can't start another")
		t.equal(reason, "busy", "busy reason")
		FighterState.extendRecovery(state, attack.token, 1)
		t.near(attack.recoveryEnd, 2.9, 1e-9, "longer recovery")
		local ends = FighterState.finishAbility(state, attack.token, 1.3)
		t.near(ends :: number, 1.6, 1e-9, "finished early")
		FighterState.applyStun(state, 0.5, 1.4)
		t.equal(FighterState.isCurrent(state, attack.token), false, "a stun interrupts it")
	end)

	t.test("super armor takes hits without flinching, then runs out", function()
		local attacker = { id = "A", state = FighterState.new("A", Combat, 0), position = Vector3.new(0, 0, 0), look = Vector3.new(0, 0, -1) }
		local defender = { id = "D", state = FighterState.new("D", Combat, 0), position = Vector3.new(0, 0, -4), look = Vector3.new(0, 0, 1) }
		FighterState.startAbility(defender.state, { Startup = 1, Active = 0.2, Recovery = 0.2, Armor = 1 }, 1)
		local light = Combat.Light.Steps[1]
		local first = HitResolver.resolve(light, Combat, attacker, defender, 1.2)
		t.equal(first.armored, true, "armored")
		t.equal(first.hitstun, 0, "no flinch")
		t.truthy(first.damage > 0, "damage still lands")
		HitResolver.apply(first, Combat, attacker, defender, 1.2)
		t.equal(FighterState.isAttacking(defender.state, 1.3), true, "still casting")
		local second = HitResolver.resolve(light, Combat, attacker, defender, 1.4)
		t.equal(second.armored, false, "armor used up")
		HitResolver.apply(second, Combat, attacker, defender, 1.4)
		t.equal(FighterState.isAttacking(defender.state, 1.45), false, "second hit interrupts")
	end)
end
