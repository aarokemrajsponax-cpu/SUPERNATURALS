local FighterState = Harness.load("Shared/Combat/FighterState")
local Config = Harness.load("Shared/Config/Combat")

return function(t)
	local function fresh(now)
		return FighterState.new("A", Config, now or 0)
	end

	t.test("a new fighter can act and moves at walk speed", function()
		local s = fresh()
		local speed, jump, rotate = FighterState.movement(s, Config, 1)
		t.equal(speed, Config.Movement.WalkSpeed, "speed")
		t.equal(jump, Config.Movement.JumpHeight, "jump")
		t.equal(rotate, true, "auto rotate")
	end)

	t.test("light attacks chain through every step, then rest", function()
		local s = fresh()
		local now = 1
		for step = 1, #Config.Light.Steps do
			local attack, reason = FighterState.startLight(s, Config, now)
			t.truthy(attack, "step " .. step .. " started (" .. tostring(reason) .. ")")
			t.equal(attack and attack.step, step, "step number")
			FighterState.endActive(s, Config, attack.token, true)
			now = attack.recoveryEnd
			FighterState.finishAttack(s, now)
		end
		local again, reason = FighterState.startLight(s, Config, now)
		t.equal(again, nil, "blocked right after the finisher")
		t.equal(reason, "cooldown", "reason")
		local later = FighterState.startLight(s, Config, now + Config.Light.ChainCooldown + 0.01)
		t.equal(later and later.step, 1, "a new chain starts at step 1")
	end)

	t.test("the chain resets if you wait too long", function()
		local s = fresh()
		local first = FighterState.startLight(s, Config, 1)
		local resume = first.recoveryEnd + Config.Light.ChainWindow + 0.05
		FighterState.finishAttack(s, first.recoveryEnd)
		local second = FighterState.startLight(s, Config, resume)
		t.equal(second.step, 1, "back to step 1")
	end)

	t.test("pressing light just before a swing ends is buffered", function()
		local s = fresh()
		local first = FighterState.startLight(s, Config, 1)
		local early = first.recoveryEnd - Config.InputBuffer / 2
		local attack, reason = FighterState.startLight(s, Config, early)
		t.equal(attack, nil, "not started yet")
		t.equal(reason, "buffered", "reason")
		t.equal(FighterState.finishAttack(s, first.recoveryEnd), true, "buffer released when the swing ends")
		local tooEarly = fresh()
		local swing = FighterState.startLight(tooEarly, Config, 1)
		local _, why = FighterState.startLight(tooEarly, Config, swing.startedAt + 0.01)
		t.equal(why, "busy", "pressing mid-swing is not buffered")
	end)

	t.test("a missed heavy is punished with longer recovery", function()
		local hit = fresh()
		local heavyHit = FighterState.startHeavy(hit, Config, 1)
		FighterState.endActive(hit, Config, heavyHit.token, true)
		local miss = fresh()
		local heavyMiss = FighterState.startHeavy(miss, Config, 1)
		FighterState.endActive(miss, Config, heavyMiss.token, false)
		t.truthy(heavyMiss.recoveryEnd > heavyHit.recoveryEnd, "whiff recovers later")
		t.near(heavyMiss.recoveryEnd - heavyMiss.activeEnd, Config.Heavy.WhiffRecovery, 1e-9, "whiff recovery")
		t.truthy(miss.heavyReadyAt >= heavyMiss.recoveryEnd, "cooldown covers the recovery")
	end)

	t.test("heavy has a cooldown", function()
		local s = fresh()
		local attack = FighterState.startHeavy(s, Config, 1)
		FighterState.endActive(s, Config, attack.token, true)
		FighterState.finishAttack(s, attack.recoveryEnd)
		local _, reason = FighterState.startHeavy(s, Config, attack.recoveryEnd + 0.01)
		t.equal(reason, "cooldown", "on cooldown")
		local again = FighterState.startHeavy(s, Config, 1 + Config.Heavy.Cooldown + 0.01)
		t.truthy(again, "ready after the cooldown")
	end)

	t.test("stun cancels an attack and expires on its own", function()
		local s = fresh()
		local attack = FighterState.startHeavy(s, Config, 1)
		FighterState.applyStun(s, 0.8, 1.2)
		t.equal(FighterState.isCurrent(s, attack.token), false, "attack cancelled")
		t.equal(FighterState.isStunned(s, 1.5), true, "stunned during")
		local speed = FighterState.movement(s, Config, 1.5)
		t.equal(speed, 0, "can't move while stunned")
		t.equal(FighterState.isStunned(s, 2.01), false, "stun over")
		local after = FighterState.movement(s, Config, 2.01)
		t.equal(after, Config.Movement.WalkSpeed, "walking again")
		local _, reason = FighterState.startLight(s, Config, 1.5)
		t.equal(reason, "stunned", "can't attack while stunned")
	end)

	t.test("overlapping stuns keep the longest, never stack forever", function()
		local s = fresh()
		FighterState.applyStun(s, 1, 0)
		FighterState.applyStun(s, 0.2, 0.5)
		t.near(s.stunUntil, 1, 1e-9, "short stun doesn't shorten a long one")
		FighterState.applyStun(s, 1, 0.5)
		t.near(s.stunUntil, 1.5, 1e-9, "longer stun extends")
	end)

	t.test("blocking: parry window, then normal block, and a cooldown after release", function()
		local s = fresh()
		t.truthy(FighterState.startBlock(s, 1), "block raised")
		t.equal(FighterState.inParryWindow(s, Config, 1.1), true, "early in the block is a parry")
		local lateness = Config.Block.ParryWindow + Config.Block.LatencyAllowance + 0.05
		t.equal(FighterState.inParryWindow(s, Config, 1 + lateness), false, "later is a normal block")
		FighterState.endBlock(s, Config, 2)
		local again, reason = FighterState.startBlock(s, 2.05)
		t.equal(again, false, "can't re-raise instantly")
		t.equal(reason, "cooldown", "reason")
		t.truthy(FighterState.startBlock(s, 2 + Config.Block.Cooldown + 0.01), "can raise after the cooldown")
	end)

	t.test("a block re-raised while held never parries", function()
		local s = fresh()
		t.truthy(FighterState.startBlock(s, 1, false), "raised")
		t.equal(FighterState.isBlocking(s), true, "blocking")
		t.equal(FighterState.inParryWindow(s, Config, 1.01), false, "no parry window")
		FighterState.endBlock(s, Config, 2)
		FighterState.startBlock(s, 3)
		t.equal(FighterState.inParryWindow(s, Config, 3.01), true, "a fresh press can parry again")
	end)

	t.test("guard drains, breaks, and regenerates", function()
		local s = fresh()
		t.equal(FighterState.damageGuard(s, Config, 40, 1), false, "first hit doesn't break")
		t.near(FighterState.guardAt(s, Config, 1), Config.Block.MaxGuard - 40, 1e-9, "guard reduced")
		t.near(FighterState.guardAt(s, Config, 1 + Config.Block.GuardRegenDelay - 0.01), 60, 1e-9, "no regen during the delay")
		t.equal(FighterState.guardAt(s, Config, 100), Config.Block.MaxGuard, "fully regenerates, never above max")
		local broke = FighterState.damageGuard(s, Config, 999, 101)
		t.equal(broke, true, "breaks")
		t.equal(s.guard, Config.Block.GuardAfterBreak, "guard after break")
	end)

	t.test("dodge grants brief invulnerability and has a cooldown", function()
		local s = fresh()
		FighterState.startBlock(s, 0.5)
		t.truthy(FighterState.startDodge(s, Config, 1), "dodged")
		t.equal(FighterState.isBlocking(s), false, "dodging drops the block")
		t.equal(FighterState.isInvulnerable(s, 1.1), true, "invulnerable at first")
		t.equal(FighterState.isInvulnerable(s, 1 + Config.Dodge.Invulnerable + 0.01), false, "then vulnerable")
		-- A short cooldown remains after the dodge itself (stamina is the real limit)
		local _, reason = FighterState.startDodge(s, Config, 1 + Config.Dodge.Duration + Config.Dodge.Recovery + 0.01)
		t.equal(reason, "cooldown", "dodge cooldown")
		local _, busy = FighterState.startLight(s, Config, 1.05)
		t.equal(busy, "busy", "can't attack mid-dodge")
	end)

	t.test("knockout credit goes to the last attacker within the window", function()
		local s = fresh()
		FighterState.registerHit(s, Config, "B", 10)
		local credited = FighterState.knockOut(s, Config, 12)
		t.equal(credited, "B", "credited")
		local s2 = fresh()
		FighterState.registerHit(s2, Config, "B", 10)
		t.equal(FighterState.knockOut(s2, Config, 10 + Config.KnockoutCreditWindow + 1), nil, "too long ago")
	end)

	t.test("knocked out fighters can't act, and reset restores everything", function()
		local s = fresh()
		FighterState.startBlock(s, 1)
		FighterState.applyStun(s, 5, 1)
		FighterState.knockOut(s, Config, 2)
		t.equal(FighterState.startLight(s, Config, 3), nil, "no attacking when knocked out")
		t.equal(FighterState.isInvulnerable(s, 3), true, "can't be hit while knocked out")
		FighterState.reset(s, Config, 3, Config.SpawnProtection)
		t.equal(s.knockedOut, false, "back up")
		t.equal(FighterState.isStunned(s, 3), false, "stun cleared on respawn")
		t.equal(FighterState.isBlocking(s), false, "block cleared")
		t.equal(FighterState.isInvulnerable(s, 3 + Config.SpawnProtection / 2), true, "spawn protection")
		t.equal(FighterState.isInvulnerable(s, 3 + Config.SpawnProtection + 0.01), false, "protection ends")
	end)

	t.test("frozen fighters (countdown) can't move or attack, and unfreeze cleanly", function()
		local s = fresh()
		FighterState.setFrozen(s, true, Config, 1)
		local speed = FighterState.movement(s, Config, 1)
		t.equal(speed, 0, "frozen in place")
		local _, reason = FighterState.startLight(s, Config, 1)
		t.equal(reason, "unavailable", "no attacking while frozen")
		FighterState.setFrozen(s, false, Config, 2)
		t.truthy(FighterState.startLight(s, Config, 2), "can attack after unfreezing")
	end)

	t.test("every timed state ends: movement always returns to normal", function()
		local s = fresh()
		FighterState.startHeavy(s, Config, 0)
		FighterState.applyStun(s, 2, 0.1)
		FighterState.startDodge(s, Config, 5)
		FighterState.startBlock(s, 1)
		local now = 0
		local guard = 0
		while true do
			local nextAt = FighterState.nextMovementChange(s, now)
			if not nextAt then
				break
			end
			now = nextAt
			FighterState.finishAttack(s, now)
			guard += 1
			t.truthy(guard < 100, "converges")
			if guard >= 100 then
				break
			end
		end
		local speed = FighterState.movement(s, Config, now + 0.001)
		t.equal(speed, Config.Movement.WalkSpeed, "back to walking")
	end)

	t.test("attacks keep their facing and report when the fighter is free again", function()
		local s = fresh()
		local attack = FighterState.startHeavy(s, Config, 1)
		local _, _, rotate = FighterState.movement(s, Config, 1.1)
		t.equal(rotate, false, "no turning mid-attack")
		t.equal(FighterState.busyUntil(s), attack.recoveryEnd, "busy until recovery ends")
		FighterState.endActive(s, Config, attack.token, false)
		t.equal(FighterState.busyUntil(s), attack.recoveryEnd, "a missed heavy's longer recovery is reported")
		local d = fresh()
		FighterState.startDodge(d, Config, 5)
		t.near(FighterState.busyUntil(d), 5 + Config.Dodge.Duration + Config.Dodge.Recovery, 1e-9, "busy through the dodge")
	end)

	t.test("spawn protection ends when the protected fighter acts", function()
		local s = FighterState.new("A", Config, 0)
		FighterState.reset(s, Config, 10, 1.5)
		t.equal(FighterState.isInvulnerable(s, 10.5), true, "protected after respawning")
		FighterState.dropProtection(s, 10.6)
		t.equal(FighterState.isInvulnerable(s, 10.7), false, "attacking ends it")
	end)

	t.test("attacking drops the block", function()
		local s = fresh()
		FighterState.startBlock(s, 1)
		FighterState.endBlock(s, Config, 1.5)
		FighterState.startBlock(s, 1.5 + Config.Block.Cooldown + 0.01)
		local _, reason = FighterState.startLight(s, Config, 3)
		t.equal(reason, nil, "attack started")
		t.equal(FighterState.isBlocking(s), false, "no longer blocking")
	end)

	t.test("combo count builds and resets after a pause", function()
		local s = fresh()
		t.equal(FighterState.registerHit(s, Config, "B", 1), 1, "first hit")
		t.equal(FighterState.registerHit(s, Config, "B", 1.3), 2, "second hit")
		t.equal(FighterState.registerHit(s, Config, "B", 1.3 + Config.ComboResetTime + 0.1), 1, "reset")
	end)

	-- Fighting System v2 ---------------------------------------------------------------

	local Costs = Config.Stamina.Costs

	t.test("stamina: dodges spend it, it refills after a delay, never above the maximum", function()
		local s = fresh()
		FighterState.startDodge(s, Config, 1)
		t.near(FighterState.staminaAt(s, Config, 1), Config.Stamina.Max - Costs.Dodge, 1e-9, "dodge cost")
		t.near(FighterState.staminaAt(s, Config, 1 + Config.Stamina.RegenDelay * 0.5), Config.Stamina.Max - Costs.Dodge, 1e-9, "no refill during the delay")
		local later = 1 + Config.Stamina.RegenDelay + 0.2
		t.near(FighterState.staminaAt(s, Config, later), Config.Stamina.Max - Costs.Dodge + 0.2 * Config.Stamina.Regen, 1e-6, "refills at Regen per second")
		t.equal(FighterState.staminaAt(s, Config, 60), Config.Stamina.Max, "caps at the maximum")
	end)

	t.test("stamina: running dry winds you (no dodge, no sprint) until it recovers", function()
		local s = fresh()
		local now = 1
		local dodges = 0
		while dodges < 20 do
			local ok = FighterState.startDodge(s, Config, now)
			if not ok then
				break
			end
			dodges += 1
			now += Config.Dodge.Cooldown + 0.01
		end
		t.equal(dodges, math.ceil(Config.Stamina.Max / Costs.Dodge), "dodges until empty")
		t.equal(s.winded, true, "winded at 0")
		t.equal(FighterState.isWinded(s, Config, now), true, "isWinded")
		local _, reason = FighterState.startDodge(s, Config, now + 0.5)
		t.equal(reason, "winded", "no dodge while winded")
		local _, sprint = FighterState.startSprint(s, Config, now + 0.5)
		t.equal(sprint, "winded", "no sprint while winded")
		local recoverAt = FighterState.nextStaminaChange(s, Config, now)
		t.truthy(recoverAt and recoverAt > now, "a recovery time is scheduled")
		t.equal(FighterState.settleStamina(s, Config, (recoverAt :: number) + 0.01), "Recovered", "recovers at WindedRecover")
		t.equal(s.winded, false, "no longer winded")
		t.truthy(FighterState.startDodge(s, Config, (recoverAt :: number) + 0.02), "can dodge again")
	end)

	t.test("sprint: faster, drains stamina, stops by itself when it runs dry", function()
		local s = fresh()
		t.truthy(FighterState.startSprint(s, Config, 1), "sprint starts")
		t.equal(FighterState.isSprinting(s, 1.1), true, "sprinting")
		t.equal((FighterState.movement(s, Config, 1.1)), Config.Sprint.Speed, "sprint speed")
		t.near(FighterState.staminaAt(s, Config, 2), Config.Stamina.Max - Costs.SprintPerSecond, 1e-6, "drains per second")
		local dryAt = FighterState.nextStaminaChange(s, Config, 1) :: number
		t.near(dryAt, 1 + Config.Stamina.Max / Costs.SprintPerSecond, 1e-6, "runs dry on schedule")
		t.equal(FighterState.settleStamina(s, Config, dryAt + 0.01), "Winded", "winded when dry")
		t.equal(FighterState.isSprinting(s, dryAt + 0.02), false, "sprint ended by itself")
		t.equal((FighterState.movement(s, Config, dryAt + 0.02)), Config.Movement.WalkSpeed, "back to walking")
		local b = fresh()
		b.stamina = Config.Sprint.MinStamina - 1
		b.staminaSpentAt = 0
		local _, low = FighterState.startSprint(b, Config, 0.1)
		t.equal(low, "stamina", "needs MinStamina to start")
		local c = fresh()
		FighterState.startSprint(c, Config, 1)
		FighterState.startLight(c, Config, 1.2)
		t.equal(FighterState.isSprinting(c, 1.25), false, "not sprinting mid-attack")
		t.truthy(FighterState.endSprint(c, Config, 1.3), "sprint released")
		t.equal(FighterState.endSprint(c, Config, 1.4), false, "already released")
	end)

	t.test("move variants come from the situation", function()
		local function name(action, context)
			return (FighterState.chooseMove(Config, action, context))
		end
		t.equal(name("Light", {}), "Light", "plain light")
		t.equal(name("Light", { air = true }), "AirKick", "air light")
		t.equal(name("Light", { sprinting = true }), "RushStrike", "sprint light")
		t.equal(name("Heavy", {}), "Heavy", "plain heavy")
		t.equal(name("Heavy", { air = true, sprinting = true }), "Slam", "the air wins")
		t.equal(name("Heavy", { sprinting = true }), "ShoulderCharge", "sprint heavy")
		t.equal(name("Heavy", { back = true }), "Launcher", "back heavy")
		local s = fresh()
		local _, def = FighterState.chooseMove(Config, "Heavy", { back = true })
		local launcher = FighterState.startVariant(s, Config, "Heavy", def, 1)
		t.equal(launcher and launcher.move, "Launcher", "launcher started")
		FighterState.finishAttack(s, (launcher :: any).recoveryEnd)
		local _, cooldown = FighterState.startHeavy(s, Config, (launcher :: any).recoveryEnd + 0.01)
		t.equal(cooldown, "cooldown", "variants share the heavy cooldown")
		local carrier = fresh()
		FighterState.pickUp(carrier, "Crate", 1)
		local _, carrying = FighterState.startVariant(carrier, Config, "Light", Config.Air.Light, 1.1)
		t.equal(carrying, "carrying", "no strikes with a prop in hand")
	end)

	t.test("charged heavy: slower walk, grows with the hold, a full charge breaks guard and knocks down", function()
		local charge = Config.Heavy.Charge
		local s = fresh()
		local attack = FighterState.startCharge(s, Config, 1)
		t.truthy(attack, "charging")
		t.equal(FighterState.isCharging(s, 1.1), true, "isCharging")
		t.equal((FighterState.movement(s, Config, 1.1)), charge.MoveSpeed, "walk slows")
		t.near(FighterState.staminaAt(s, Config, 1), Config.Stamina.Max - Costs.Charge, 1e-9, "charging costs stamina")
		t.equal(FighterState.inWindup(s, 1.1), true, "a charge is a wind-up (counter hits)")
		local tap = FighterState.releaseCharge(s, Config, 1 + charge.Min * 0.5)
		t.equal(tap and tap.move, "Heavy", "a short hold is a normal heavy")
		t.equal(tap and tap.charge, 0, "no charge")

		local m = fresh()
		FighterState.startCharge(m, Config, 1)
		local half = FighterState.releaseCharge(m, Config, 1 + charge.Max * 0.5) :: any
		t.equal(half.move, "ChargedHeavy", "charged")
		t.near(half.charge, 0.5, 1e-6, "half charge")
		t.near(half.def.Damage, Config.Heavy.Damage * (1 + charge.DamageBonus * 0.5), 1e-6, "more damage")
		t.equal(half.def.GuardBreak, nil, "half a charge doesn't break guard")
		t.near(half.activeAt - (1 + charge.Max * 0.5), charge.ReleaseStartup, 1e-6, "swings quickly after release")

		local f = fresh()
		FighterState.startCharge(f, Config, 1)
		local full = FighterState.releaseCharge(f, Config, 1 + charge.Max + 0.05) :: any
		t.truthy(full, "a release just after it filled still counts")
		t.equal(full.charge, 1, "full")
		t.equal(full.def.GuardBreak, true, "breaks guard")
		t.equal(full.def.Knockdown, true, "knocks down")

		local late = fresh()
		FighterState.startCharge(late, Config, 1)
		t.equal(FighterState.isCharging(late, 1 + charge.Max + 0.01), false, "a charge ends on its own")
		local none, reason = FighterState.releaseCharge(late, Config, 1 + charge.Max + 1)
		t.equal(none, nil, "too late to release")
		t.equal(reason, "not charging", "reason")
		local idle = fresh()
		local _, nothing = FighterState.releaseCharge(idle, Config, 1)
		t.equal(nothing, "not charging", "nothing to release")
	end)

	t.test("feint: cancels a heavy's wind-up or a charge, costs stamina, has a cooldown", function()
		local s = fresh()
		local heavy = FighterState.startHeavy(s, Config, 1) :: any
		t.truthy(FighterState.feint(s, Config, 1.1), "feinted the wind-up")
		t.equal(s.attack, nil, "the heavy is gone")
		t.near(FighterState.staminaAt(s, Config, 1.1), Config.Stamina.Max - Costs.Feint, 1e-9, "feint cost")
		local _, busy = FighterState.startLight(s, Config, 1.1 + Config.Feint.Recovery * 0.5)
		t.equal(busy, "busy", "a short recovery")
		t.truthy(FighterState.startHeavy(s, Config, 1.1 + Config.Feint.Recovery + 0.01), "the heavy comes back quickly")
		local _, cooldown = FighterState.feint(s, Config, 1.1 + Config.Feint.Recovery + 0.05)
		t.equal(cooldown, "cooldown", "feint cooldown")
		local _ = heavy

		local late = fresh()
		local swing = FighterState.startHeavy(late, Config, 1) :: any
		local _, nothing = FighterState.feint(late, Config, swing.activeAt + 0.01)
		t.equal(nothing, "nothing to feint", "too late once it swings")
		local light = fresh()
		FighterState.startLight(light, Config, 1)
		local _, notHeavy = FighterState.feint(light, Config, 1.01)
		t.equal(notHeavy, "nothing to feint", "lights can't be feinted")
		local c = fresh()
		FighterState.startCharge(c, Config, 1)
		t.truthy(FighterState.feint(c, Config, 1.5), "a charge can be feinted")
		t.equal(FighterState.isCharging(c, 1.5), false, "charge cancelled")
	end)

	t.test("sweep: a low knockdown kick with its own cooldown", function()
		local s = fresh()
		local sweep = FighterState.startSweep(s, Config, 1) :: any
		t.equal(sweep.move, "Sweep", "sweep move")
		t.equal(sweep.def.Low, true, "low")
		t.equal(sweep.def.Knockdown, true, "knocks down")
		FighterState.finishAttack(s, sweep.recoveryEnd)
		local _, reason = FighterState.startSweep(s, Config, sweep.recoveryEnd + 0.01)
		t.equal(reason, "cooldown", "cooldown")
	end)

	t.test("grab: costs stamina, locks both fighters, tech window, every hold ends on its own", function()
		local a, v = FighterState.new("A", Config, 0), FighterState.new("V", Config, 0)
		local grab = FighterState.startGrab(a, Config, 1) :: any
		t.equal(grab.move, "Grab", "grab move")
		t.near(FighterState.staminaAt(a, Config, 1), Config.Stamina.Max - Costs.Grab, 1e-9, "grab cost")
		t.near(grab.recoveryEnd - grab.activeEnd, Config.Grab.WhiffRecovery, 1e-9, "a whiff recovers slowly")
		FighterState.startBlock(v, 1)
		local at = grab.activeAt
		FighterState.grabConnect(a, v, Config, at)
		t.equal(FighterState.isBlocking(v), false, "grabs beat blocks")
		t.equal(FighterState.isGrabbed(v, at + 0.1), true, "victim held")
		t.equal(FighterState.isHolding(a, at + 0.1), true, "attacker holds")
		t.equal((FighterState.movement(v, Config, at + 0.1)), 0, "victim can't walk")
		t.equal((FighterState.movement(a, Config, at + 0.1)), 0, "holder can't walk")
		t.equal(FighterState.canTech(v, Config, at + Config.Grab.TechWindow), true, "tech inside the window")
		t.equal(FighterState.canTech(v, Config, at + Config.Grab.TechWindow + Config.Block.LatencyAllowance + 0.01), false, "too late to tech")
		local held, grabbed = FighterState.startLight(v, Config, at + 0.2)
		t.equal(held == nil and grabbed ~= nil, true, "the victim can't attack")
		local _, holding = FighterState.startLight(a, Config, at + 0.2)
		t.equal(holding, "busy", "the holder can't attack either")
		-- Nobody throws: both are free by themselves shortly after Hold
		local free = at + Config.Grab.Hold + 0.2
		t.equal(FighterState.isGrabbed(v, free), false, "victim freed by time")
		t.equal(FighterState.isHolding(a, free), false, "holder freed by time")
		t.truthy(FighterState.startLight(v, Config, free), "victim can act")
		FighterState.finishAttack(a, free)
		t.truthy(FighterState.startDodge(a, Config, free), "holder can act")

		local a2, v2 = FighterState.new("A", Config, 0), FighterState.new("V", Config, 0)
		FighterState.startGrab(a2, Config, 1)
		FighterState.grabConnect(a2, v2, Config, 1.3)
		FighterState.releaseGrab(a2, v2, 1.4)
		t.equal(FighterState.isGrabbed(v2, 1.41), false, "release frees the victim")
		t.equal(FighterState.isHolding(a2), false, "release frees the holder")
		t.equal(a2.attack, nil, "the grab is over")
		local _, cooldown = FighterState.startGrab(a2, Config, 1.5)
		t.equal(cooldown, "cooldown", "grab cooldown")
	end)

	t.test("taunt: open to counter hits, cooldown, ends on its own", function()
		local s = fresh()
		local taunt = FighterState.startTaunt(s, Config, 1) :: any
		t.truthy(taunt, "taunting")
		t.equal(FighterState.isTaunting(s, 1.5), true, "isTaunting")
		t.equal(FighterState.inWindup(s, 1.5), true, "counts as a wind-up")
		t.equal((FighterState.movement(s, Config, 1.5)), 0, "stands still")
		t.equal(FighterState.isTaunting(s, 1 + Config.Taunt.Duration + 0.01), false, "over by itself")
		FighterState.finishAttack(s, 1 + Config.Taunt.Duration + 0.01)
		local _, cooldown = FighterState.startTaunt(s, Config, 1 + Config.Taunt.Duration + 0.02)
		t.equal(cooldown, "cooldown", "taunt cooldown")
		local blocker = fresh()
		FighterState.startBlock(blocker, 1)
		local _, busy = FighterState.startTaunt(blocker, Config, 1.1)
		t.equal(busy, "busy", "no taunting behind a guard")
	end)

	t.test("knockdown: on the floor, tech roll in the window, invulnerable getting up, one hit at most", function()
		local kd = Config.Knockdown
		local s = fresh()
		FighterState.startLight(s, Config, 1)
		FighterState.knockDown(s, Config, 1)
		t.equal(s.attack, nil, "a knockdown cancels the attack")
		t.equal(FighterState.isDowned(s, 1.5), true, "downed")
		t.equal((FighterState.movement(s, Config, 1.5)), 0, "can't walk")
		local _, downed = FighterState.startLight(s, Config, 1.5)
		t.equal(downed, "downed", "can't attack")
		t.equal(FighterState.isDowned(s, 1 + kd.Duration + 0.01), false, "gets up on time")
		t.equal(FighterState.isInvulnerable(s, 1 + kd.Duration + kd.GetUpInvulnerable * 0.5), true, "invulnerable while getting up")
		t.equal(FighterState.isInvulnerable(s, 1 + kd.Duration + kd.GetUpInvulnerable + 0.01), false, "then vulnerable")

		local r = fresh()
		FighterState.knockDown(r, Config, 1)
		t.truthy(FighterState.techRoll(r, Config, 1 + kd.TechWindow * 0.5), "tech roll")
		t.equal(FighterState.isDowned(r, 1 + kd.TechWindow * 0.5 + 0.01), false, "up at once")
		t.equal(FighterState.isInvulnerable(r, 1 + kd.TechWindow * 0.5 + 0.1), true, "invulnerable rolling")
		t.near(FighterState.staminaAt(r, Config, 1.2), Config.Stamina.Max - Costs.TechRoll, 1e-9, "tech roll cost")
		local late = fresh()
		FighterState.knockDown(late, Config, 1)
		local _, reason = FighterState.techRoll(late, Config, 1 + kd.TechWindow + Config.Block.LatencyAllowance + 0.05)
		t.equal(reason, "too late", "tech window")
		local _, standing = FighterState.techRoll(fresh(), Config, 1)
		t.equal(standing, "not downed", "only from the floor")

		local o = fresh()
		FighterState.knockDown(o, Config, 1)
		t.equal(FighterState.isInvulnerable(o, 1.2), false, "a downed fighter can be hit once")
		FighterState.hitWhileDowned(o, Config, 1.2)
		t.equal(FighterState.isInvulnerable(o, 1.3), true, "but only once")
		t.equal(FighterState.isDowned(o, 1.2 + 0.31), false, "and gets up right after")
	end)

	t.test("air: launched fighters can breakfall after a moment; the juggle ends on its own", function()
		local air = Config.Air
		local s = fresh()
		FighterState.launch(s, Config, 1)
		t.equal(FighterState.isAirborne(s, 1.1), true, "airborne")
		local _, early = FighterState.breakfall(s, Config, 1 + air.BreakfallAfter * 0.5)
		t.equal(early, "too early", "not straight away")
		t.truthy(FighterState.breakfall(s, Config, 1 + air.BreakfallAfter + 0.01), "breakfall")
		t.equal(FighterState.isAirborne(s, 1 + air.BreakfallAfter + 0.02), false, "out of the juggle")
		t.equal(FighterState.isInvulnerable(s, 1 + air.BreakfallAfter + 0.05), true, "briefly invulnerable")
		local j = fresh()
		FighterState.launch(j, Config, 1)
		j.juggleCount = 2
		FighterState.launch(j, Config, 1.2)
		t.equal(j.juggleCount, 2, "relaunching keeps the juggle count")
		t.equal(FighterState.isAirborne(j, 1.2 + air.MaxAirborne + 0.01), false, "never airborne forever")
		FighterState.land(j, 1.5)
		t.equal(j.juggleCount, 0, "landing resets the count")
	end)

	t.test("props: carrying slows you and stops blocking and sprinting; dropping lets go", function()
		local s = fresh()
		t.truthy(FighterState.pickUp(s, "Crate", 1), "picked up")
		t.equal((FighterState.movement(s, Config, 1.1)), Config.Carry.WalkSpeed, "slower walk")
		local _, block = FighterState.startBlock(s, 1.1)
		t.equal(block, "carrying", "no blocking")
		local _, sprint = FighterState.startSprint(s, Config, 1.1)
		t.equal(sprint, "carrying", "no sprinting")
		local _, again = FighterState.pickUp(s, "Barrel", 1.2)
		t.equal(again, "already", "one at a time")
		t.equal(FighterState.dropCarried(s), "Crate", "dropped")
		t.equal(s.carrying, nil, "empty-handed")
	end)

	t.test("directional dodges: styles, their numbers, dodge-cancel and perfect dodges", function()
		local look = Vector3.new(0, 0, -1)
		t.equal(FighterState.dodgeStyle(look, nil), "Back", "no input = backstep")
		t.equal(FighterState.dodgeStyle(look, Vector3.new(0, 0, -1)), "Forward", "forward")
		t.equal(FighterState.dodgeStyle(look, Vector3.new(1, 0, 0)), "Side", "side")
		t.equal(FighterState.dodgeStyle(look, Vector3.new(0, 0, 1)), "Back", "back")
		t.equal(FighterState.dodgeStyle(look, Vector3.new(0.1, 0, 0)), "Back", "a tiny tilt is no input")
		local s = fresh()
		local _, _, forward = FighterState.startDodge(s, Config, 1, "Forward")
		t.equal(forward.speed, Config.Dodge.Directions.Forward.Speed, "forward speed")
		t.equal(FighterState.isInvulnerable(s, 1 + Config.Dodge.Directions.Forward.Invulnerable + 0.01), false, "forward is invulnerable for less")
		t.equal(FighterState.claimPerfectDodge(s, Config, 1.05), true, "perfect dodge right after starting")
		t.equal(FighterState.claimPerfectDodge(s, Config, 1.06), false, "only once per dodge")
		local late = fresh()
		FighterState.startDodge(late, Config, 1, "Side")
		t.equal(FighterState.claimPerfectDodge(late, Config, 1 + Config.Dodge.PerfectWindow + Config.Block.LatencyAllowance + 0.01), false, "not when it started too early")

		local c = fresh()
		local light = FighterState.startLight(c, Config, 1) :: any
		FighterState.endActive(c, Config, light.token, true)
		local ok, _, numbers = FighterState.startDodge(c, Config, light.activeEnd + 0.01, "Back")
		t.equal(ok, true, "a landed light's recovery can be dodge-cancelled")
		t.equal(numbers.cancel, true, "flagged as a cancel")
		t.near(FighterState.staminaAt(c, Config, light.activeEnd + 0.01), Config.Stamina.Max - Costs.DodgeCancel, 1e-9, "cancel cost")
		t.equal(c.attack, nil, "the light is cancelled")
		local w = fresh()
		local whiff = FighterState.startLight(w, Config, 1) :: any
		FighterState.endActive(w, Config, whiff.token, false)
		local _, busy = FighterState.startDodge(w, Config, whiff.activeEnd + 0.01)
		t.equal(busy, "busy", "a whiff can't be cancelled")
	end)

	t.test("a parry earns a riposte on the next light inside the window", function()
		local s = fresh()
		s.riposteUntil = 1 + Config.Riposte.Window
		local light = FighterState.startLight(s, Config, 1.2) :: any
		t.equal(light.riposte, true, "riposte")
		FighterState.finishAttack(s, light.recoveryEnd)
		local next = FighterState.startLight(s, Config, light.recoveryEnd + 0.01) :: any
		t.equal(next.riposte, false, "only one")
	end)

	t.test("knockouts, respawns and cleanup clear every v2 state", function()
		local s = fresh()
		FighterState.startSprint(s, Config, 1)
		FighterState.pickUp(s, "Crate", 1)
		FighterState.launch(s, Config, 1)
		s.grabbedById = "X"
		s.grabUntil = 5
		s.holdingId = "Y"
		s.holdUntil = 5
		FighterState.knockOut(s, Config, 1.1)
		t.equal(s.carrying, nil, "prop gone")
		t.equal(s.sprintHeld, false, "sprint gone")
		t.equal(FighterState.isAirborne(s, 1.2), false, "juggle gone")
		t.equal(s.grabbedById == nil and s.holdingId == nil, true, "grabs gone")
		local r = fresh()
		FighterState.knockDown(r, Config, 1)
		FighterState.startCharge(fresh(), Config, 1)
		r.stamina = 3
		FighterState.reset(r, Config, 2, 0)
		t.equal(FighterState.isDowned(r, 2), false, "respawn: standing")
		t.equal(FighterState.staminaAt(r, Config, 2), Config.Stamina.Max, "respawn: full stamina")
		t.equal(r.winded, false, "respawn: not winded")
		t.equal(FighterState.busyUntil(r) <= 2, true, "respawn: free to act")
	end)
end
