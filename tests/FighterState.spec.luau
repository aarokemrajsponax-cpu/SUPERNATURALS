local FighterState = Harness.load("Shared/Combat/FighterState")
local Config = Harness.load("Shared/Config/Combat")

return function(t)
	local function fresh(now)
		return FighterState.new("A", Config, now or 0)
	end

	t.test("a new fighter can act and moves at walk speed", function()
		local s = fresh()
		local speed, jump, rotate = FighterState.movement(s, Config, 1)
		t.equal(speed, Config.Movement.WalkSpeed, "speed")
		t.equal(jump, Config.Movement.JumpHeight, "jump")
		t.equal(rotate, true, "auto rotate")
	end)

	t.test("light attacks chain through every step, then rest", function()
		local s = fresh()
		local now = 1
		for step = 1, #Config.Light.Steps do
			local attack, reason = FighterState.startLight(s, Config, now)
			t.truthy(attack, "step " .. step .. " started (" .. tostring(reason) .. ")")
			t.equal(attack and attack.step, step, "step number")
			FighterState.endActive(s, Config, attack.token, true)
			now = attack.recoveryEnd
			FighterState.finishAttack(s, now)
		end
		local again, reason = FighterState.startLight(s, Config, now)
		t.equal(again, nil, "blocked right after the finisher")
		t.equal(reason, "cooldown", "reason")
		local later = FighterState.startLight(s, Config, now + Config.Light.ChainCooldown + 0.01)
		t.equal(later and later.step, 1, "a new chain starts at step 1")
	end)

	t.test("the chain resets if you wait too long", function()
		local s = fresh()
		local first = FighterState.startLight(s, Config, 1)
		local resume = first.recoveryEnd + Config.Light.ChainWindow + 0.05
		FighterState.finishAttack(s, first.recoveryEnd)
		local second = FighterState.startLight(s, Config, resume)
		t.equal(second.step, 1, "back to step 1")
	end)

	t.test("pressing light just before a swing ends is buffered", function()
		local s = fresh()
		local first = FighterState.startLight(s, Config, 1)
		local early = first.recoveryEnd - Config.InputBuffer / 2
		local attack, reason = FighterState.startLight(s, Config, early)
		t.equal(attack, nil, "not started yet")
		t.equal(reason, "buffered", "reason")
		t.equal(FighterState.finishAttack(s, first.recoveryEnd), true, "buffer released when the swing ends")
		local tooEarly = fresh()
		local swing = FighterState.startLight(tooEarly, Config, 1)
		local _, why = FighterState.startLight(tooEarly, Config, swing.startedAt + 0.01)
		t.equal(why, "busy", "pressing mid-swing is not buffered")
	end)

	t.test("a missed heavy is punished with longer recovery", function()
		local hit = fresh()
		local heavyHit = FighterState.startHeavy(hit, Config, 1)
		FighterState.endActive(hit, Config, heavyHit.token, true)
		local miss = fresh()
		local heavyMiss = FighterState.startHeavy(miss, Config, 1)
		FighterState.endActive(miss, Config, heavyMiss.token, false)
		t.truthy(heavyMiss.recoveryEnd > heavyHit.recoveryEnd, "whiff recovers later")
		t.near(heavyMiss.recoveryEnd - heavyMiss.activeEnd, Config.Heavy.WhiffRecovery, 1e-9, "whiff recovery")
		t.truthy(miss.heavyReadyAt >= heavyMiss.recoveryEnd, "cooldown covers the recovery")
	end)

	t.test("heavy has a cooldown", function()
		local s = fresh()
		local attack = FighterState.startHeavy(s, Config, 1)
		FighterState.endActive(s, Config, attack.token, true)
		FighterState.finishAttack(s, attack.recoveryEnd)
		local _, reason = FighterState.startHeavy(s, Config, attack.recoveryEnd + 0.01)
		t.equal(reason, "cooldown", "on cooldown")
		local again = FighterState.startHeavy(s, Config, 1 + Config.Heavy.Cooldown + 0.01)
		t.truthy(again, "ready after the cooldown")
	end)

	t.test("stun cancels an attack and expires on its own", function()
		local s = fresh()
		local attack = FighterState.startHeavy(s, Config, 1)
		FighterState.applyStun(s, 0.8, 1.2)
		t.equal(FighterState.isCurrent(s, attack.token), false, "attack cancelled")
		t.equal(FighterState.isStunned(s, 1.5), true, "stunned during")
		local speed = FighterState.movement(s, Config, 1.5)
		t.equal(speed, 0, "can't move while stunned")
		t.equal(FighterState.isStunned(s, 2.01), false, "stun over")
		local after = FighterState.movement(s, Config, 2.01)
		t.equal(after, Config.Movement.WalkSpeed, "walking again")
		local _, reason = FighterState.startLight(s, Config, 1.5)
		t.equal(reason, "stunned", "can't attack while stunned")
	end)

	t.test("overlapping stuns keep the longest, never stack forever", function()
		local s = fresh()
		FighterState.applyStun(s, 1, 0)
		FighterState.applyStun(s, 0.2, 0.5)
		t.near(s.stunUntil, 1, 1e-9, "short stun doesn't shorten a long one")
		FighterState.applyStun(s, 1, 0.5)
		t.near(s.stunUntil, 1.5, 1e-9, "longer stun extends")
	end)

	t.test("blocking: parry window, then normal block, and a cooldown after release", function()
		local s = fresh()
		t.truthy(FighterState.startBlock(s, 1), "block raised")
		t.equal(FighterState.inParryWindow(s, Config, 1.1), true, "early in the block is a parry")
		local lateness = Config.Block.ParryWindow + Config.Block.LatencyAllowance + 0.05
		t.equal(FighterState.inParryWindow(s, Config, 1 + lateness), false, "later is a normal block")
		FighterState.endBlock(s, Config, 2)
		local again, reason = FighterState.startBlock(s, 2.05)
		t.equal(again, false, "can't re-raise instantly")
		t.equal(reason, "cooldown", "reason")
		t.truthy(FighterState.startBlock(s, 2 + Config.Block.Cooldown + 0.01), "can raise after the cooldown")
	end)

	t.test("a block re-raised while held never parries", function()
		local s = fresh()
		t.truthy(FighterState.startBlock(s, 1, false), "raised")
		t.equal(FighterState.isBlocking(s), true, "blocking")
		t.equal(FighterState.inParryWindow(s, Config, 1.01), false, "no parry window")
		FighterState.endBlock(s, Config, 2)
		FighterState.startBlock(s, 3)
		t.equal(FighterState.inParryWindow(s, Config, 3.01), true, "a fresh press can parry again")
	end)

	t.test("guard drains, breaks, and regenerates", function()
		local s = fresh()
		t.equal(FighterState.damageGuard(s, Config, 40, 1), false, "first hit doesn't break")
		t.near(FighterState.guardAt(s, Config, 1), Config.Block.MaxGuard - 40, 1e-9, "guard reduced")
		t.near(FighterState.guardAt(s, Config, 1 + Config.Block.GuardRegenDelay - 0.01), 60, 1e-9, "no regen during the delay")
		t.equal(FighterState.guardAt(s, Config, 100), Config.Block.MaxGuard, "fully regenerates, never above max")
		local broke = FighterState.damageGuard(s, Config, 999, 101)
		t.equal(broke, true, "breaks")
		t.equal(s.guard, Config.Block.GuardAfterBreak, "guard after break")
	end)

	t.test("dodge grants brief invulnerability and has a cooldown", function()
		local s = fresh()
		FighterState.startBlock(s, 0.5)
		t.truthy(FighterState.startDodge(s, Config, 1), "dodged")
		t.equal(FighterState.isBlocking(s), false, "dodging drops the block")
		t.equal(FighterState.isInvulnerable(s, 1.1), true, "invulnerable at first")
		t.equal(FighterState.isInvulnerable(s, 1 + Config.Dodge.Invulnerable + 0.01), false, "then vulnerable")
		local _, reason = FighterState.startDodge(s, Config, 1.5)
		t.equal(reason, "cooldown", "dodge cooldown")
		local _, busy = FighterState.startLight(s, Config, 1.05)
		t.equal(busy, "busy", "can't attack mid-dodge")
	end)

	t.test("knockout credit goes to the last attacker within the window", function()
		local s = fresh()
		FighterState.registerHit(s, Config, "B", 10)
		local credited = FighterState.knockOut(s, Config, 12)
		t.equal(credited, "B", "credited")
		local s2 = fresh()
		FighterState.registerHit(s2, Config, "B", 10)
		t.equal(FighterState.knockOut(s2, Config, 10 + Config.KnockoutCreditWindow + 1), nil, "too long ago")
	end)

	t.test("knocked out fighters can't act, and reset restores everything", function()
		local s = fresh()
		FighterState.startBlock(s, 1)
		FighterState.applyStun(s, 5, 1)
		FighterState.knockOut(s, Config, 2)
		t.equal(FighterState.startLight(s, Config, 3), nil, "no attacking when knocked out")
		t.equal(FighterState.isInvulnerable(s, 3), true, "can't be hit while knocked out")
		FighterState.reset(s, Config, 3, Config.SpawnProtection)
		t.equal(s.knockedOut, false, "back up")
		t.equal(FighterState.isStunned(s, 3), false, "stun cleared on respawn")
		t.equal(FighterState.isBlocking(s), false, "block cleared")
		t.equal(FighterState.isInvulnerable(s, 3 + Config.SpawnProtection / 2), true, "spawn protection")
		t.equal(FighterState.isInvulnerable(s, 3 + Config.SpawnProtection + 0.01), false, "protection ends")
	end)

	t.test("frozen fighters (countdown) can't move or attack, and unfreeze cleanly", function()
		local s = fresh()
		FighterState.setFrozen(s, true, Config, 1)
		local speed = FighterState.movement(s, Config, 1)
		t.equal(speed, 0, "frozen in place")
		local _, reason = FighterState.startLight(s, Config, 1)
		t.equal(reason, "unavailable", "no attacking while frozen")
		FighterState.setFrozen(s, false, Config, 2)
		t.truthy(FighterState.startLight(s, Config, 2), "can attack after unfreezing")
	end)

	t.test("every timed state ends: movement always returns to normal", function()
		local s = fresh()
		FighterState.startHeavy(s, Config, 0)
		FighterState.applyStun(s, 2, 0.1)
		FighterState.startDodge(s, Config, 5)
		FighterState.startBlock(s, 1)
		local now = 0
		local guard = 0
		while true do
			local nextAt = FighterState.nextMovementChange(s, now)
			if not nextAt then
				break
			end
			now = nextAt
			FighterState.finishAttack(s, now)
			guard += 1
			t.truthy(guard < 100, "converges")
			if guard >= 100 then
				break
			end
		end
		local speed = FighterState.movement(s, Config, now + 0.001)
		t.equal(speed, Config.Movement.WalkSpeed, "back to walking")
	end)

	t.test("attacking drops the block", function()
		local s = fresh()
		FighterState.startBlock(s, 1)
		FighterState.endBlock(s, Config, 1.5)
		FighterState.startBlock(s, 1.5 + Config.Block.Cooldown + 0.01)
		local _, reason = FighterState.startLight(s, Config, 3)
		t.equal(reason, nil, "attack started")
		t.equal(FighterState.isBlocking(s), false, "no longer blocking")
	end)

	t.test("combo count builds and resets after a pause", function()
		local s = fresh()
		t.equal(FighterState.registerHit(s, Config, "B", 1), 1, "first hit")
		t.equal(FighterState.registerHit(s, Config, "B", 1.3), 2, "second hit")
		t.equal(FighterState.registerHit(s, Config, "B", 1.3 + Config.ComboResetTime + 0.1), 1, "reset")
	end)
end
